{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototype",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((q,r)=>{const f=require('path').join('design',decodeURIComponent(q.url.split('?')[0])==='/'?'prototype.html':decodeURIComponent(q.url.split('?')[0]));require('fs').readFile(f,(e,b)=>{if(e){r.writeHead(404);r.end();return}r.writeHead(200,{'content-type':f.endsWith('.html')?'text/html; charset=utf-8':'application/octet-stream'});r.end(b)})}).listen(4321)"],
      "port": 4321
    }
  ]
}
